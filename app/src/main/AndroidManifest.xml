<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Floating Window Overlay Permission -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground Service Permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Loopback only, and nothing else. The libretro shim runs inside
      RetroArch's process and hands frames over 127.0.0.1 (NewSolution.md
      §4.4); AF_INET sockets need the inet GID, which this permission is, so
      there is no way to open even a loopback socket without asking for it.
      Nothing in this app contacts the network - the listener is bound to
      127.0.0.1 explicitly, never the wildcard address.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notifications for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Usage access: lets the service know whether the target emulator is on
      screen, so the overlay only paints while you are actually in the game.
      Special permission - granted by the user in Settings, not at runtime.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      All-files access: needed to write RetroArch's per-core override configs
      under /storage/emulated/0/RetroArch/config. RetroArch's MAIN config sits
      in Android/data/<pkg>/files/, which Android 11+ forbids entirely, so the
      override directory is the only reachable way in.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Package visibility (Android 11+) for the target-app picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        No backup, stated once instead of twice and contradictorily.

        The two rule files that used to be referenced here disagreed:
        data_extraction_rules.xml excluded everything (API 31+) while
        backup_rules.xml was an empty <full-backup-content>, which means back up
        EVERYTHING (API 30, which is minSdk and is what the Air Mini runs). So
        the same app backed up all of its data on one Android version and none
        of it on the next. The exclusions were also malformed - <exclude> needs
        a domain attribute - which is what lintVitalRelease finally caught when
        the first release build was assembled.

        Excluding everything was the right intent. Nothing here is worth
        restoring and some of it is actively wrong to restore: the stored
        profiles are per-console geometry settled against one screen, and the
        RetroArch config snapshots describe one particular device's emulator
        install.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RetroAIScaler"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="31">

        <!--
          singleTask, not the default "standard": this is a one-window control
          panel, and stacking instances of it is never what anyone wants.
          Without it the activity launches LAUNCH_MULTIPLE, and duplicate
          full-screen BASE_APPLICATION windows pile up above the launcher.
          They are touchable, so they silently swallow every tap meant for
          whatever is behind them - the screen shows the desktop while nothing
          on it responds.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.RetroAIScaler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

                <!-- Foreground Service for Screen Capture, Floating Ball and AI SurfaceView -->
        <service
            android:name=".service.OverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          TEMPORARY - gate 1 of the libretro shim route. Delete with
          ShimProbeService.kt once the gate is answered.

          Foreground because the measurement only means something while this
          app is in the BACKGROUND and RetroArch is in front, which is exactly
          when a plain background thread would be frozen on Android 12+.
        -->
        <service
            android:name=".shim.ShimProbeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local loopback IPC probe for the libretro shim frame source" />
        </service>

    </application>

</manifest>
