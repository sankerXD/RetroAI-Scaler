<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Floating Window Overlay Permission -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground Service Permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Notifications for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Usage access: lets the service know whether the target emulator is on
      screen, so the overlay only paints while you are actually in the game.
      Special permission - granted by the user in Settings, not at runtime.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      All-files access: needed to write RetroArch's per-core override configs
      under /storage/emulated/0/RetroArch/config. RetroArch's MAIN config sits
      in Android/data/<pkg>/files/, which Android 11+ forbids entirely, so the
      override directory is the only reachable way in.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Package visibility (Android 11+) for the target-app picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/bg_floating_ball"
        android:label="@string/app_name"
        android:roundIcon="@drawable/bg_floating_ball"
        android:supportsRtl="true"
        android:theme="@style/Theme.RetroAIScaler"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="31">

        <!--
          singleTask, not the default "standard": this is a one-window control
          panel, and stacking instances of it is never what anyone wants.
          Without it the activity launches LAUNCH_MULTIPLE, and duplicate
          full-screen BASE_APPLICATION windows pile up above the launcher.
          They are touchable, so they silently swallow every tap meant for
          whatever is behind them - the screen shows the desktop while nothing
          on it responds.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.RetroAIScaler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Service for Screen Capture, Floating Ball and AI SurfaceView -->
        <service
            android:name=".service.OverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
