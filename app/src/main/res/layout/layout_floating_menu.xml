<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_menu"
    android:padding="14dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvMenuTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseMenu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_menu_section"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/MenuSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_section_picture" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupScale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipScale1x"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1x"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipScale2x"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2x"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipScale3x"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="3x"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipScale4x"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4x"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

<com.google.android.material.chip.Chip
                    android:id="@+id/chipScale6x"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6x"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/menu_enable_ai"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAiEnable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupEngine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEnginePixelEdge"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/engine_pixel_edge"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEngineHd2d"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/engine_hd2d"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEngineShader"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/engine_shader"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEngineEspcnFast"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESPCN Fast"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEngineEspcnHq"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESPCN HQ"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEngineEspcnUltra"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESPCN Ultra"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_menu_section"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/MenuSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_section_viewport" />

            <Button
                android:id="@+id/btnDetectSource"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="@string/menu_detect_source"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:strokeColor="@color/primary" />
            <Button
                android:id="@+id/btnToggleGuide"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:text="@string/menu_show_guide"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:strokeColor="@color/primary" />
            <Button
                android:id="@+id/btnRestoreRaConfig"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:text="@string/menu_restore_ra_config"
                android:textColor="@color/accent_orange"
                android:textSize="12sp"
                app:strokeColor="@color/accent_orange" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_menu_section"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/MenuSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_section_retro" />

            <TextView
                android:id="@+id/tvScanlineLabel"
                style="@style/MenuFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <SeekBar
                android:id="@+id/seekbarScanline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvLcdGridLabel"
                style="@style/MenuFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <SeekBar
                android:id="@+id/seekbarLcdGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="15" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMaskNone"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/mask_none"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMaskAperture"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aperture"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMaskShadow"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shadow"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMaskSlot"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slot"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1.5dp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPerformanceHud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_menu_hud"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="FPS --   CAPTURE --   AI --   TOTAL --"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <!--
            HIDDEN. Developer diagnostic, not a player-facing control: it
            reports the inference cost with contention removed, which nobody
            outside this repository has a use for, and it freezes the enhanced
            picture for three seconds to do it.

            Kept in the tree rather than deleted because the numbers behind it
            are the only ones comparable across consoles, and the next time
            that question comes up the answer should be a visibility flip
            rather than a rewrite. Set visibility="visible" to bring it back;
            everything behind it is still wired and still updating.
        -->
        <Button
            android:id="@+id/btnCalibrateAi"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:text="@string/menu_calibrate"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:visibility="gone"
            app:strokeColor="@color/primary" />

        <Button
            android:id="@+id/btnStopService"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="@string/menu_stop_service"
            android:textColor="@color/accent_red"
            android:textSize="13sp"
            app:strokeColor="@color/accent_red" />

    </LinearLayout>
</ScrollView>
