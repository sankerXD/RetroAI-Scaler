    <string name="toast_shim_hw_core">This console cannot be enhanced directly. Close RetroArch, then start screen recording mode from the app.</string>
    <string name="toast_shim_no_frames">No picture arrived from the emulator. Check that the companion core is installed in RetroArch and that the game was started with it.</string>
    <string name="shim_setup_title">First-time setup</string>
    <string name="shim_setup_guide">1 · Install the core</string>
    <string name="shim_apply">2 · Update the launcher</string>
    <string name="shim_restore">Undo</string>
    <string name="toast_nothing_to_apply">Nothing to update — the launcher already points at every core that is installed.</string>
    <string name="capture_wont_fit_title">Not enough room on this screen</string>
    <string name="capture_wont_fit_body">%1$s draws at %2$d×%3$d natively.\n\nScreen recording mirrors this app\'s own output, so RetroArch has to be parked in a corner at native size and the enhanced picture has to fit in what is left. On a %4$d×%5$d screen there is no room for a picture bigger than the original.\n\nThis route cannot help this platform here - it is the screen, not the setup.</string>
    <string name="special_mode_title">Special mode</string>
    <string name="special_mode_desc">This platform is drawn on the GPU, so its picture cannot be read from inside the emulator. Screen recording works for it.</string>
    <string name="special_mode_desc_console">%1$s is drawn on the GPU, so its picture cannot be read from inside the emulator. Screen recording works for it.</string>
    <string name="shim_use_capture">Screen recording</string>
    <string name="shim_status">%1$d of %2$d consoles are set up</string>
    <string name="shim_status_none">Not set up yet — press “How to set it up”</string>
    <string name="toast_launch_restored">Put %1$d launch entries back. Reload the library in your frontend.</string>
    <string name="shim_guide_title">First-time setup</string>
    <string name="shim_guide_core_title">Core setup</string>
    <string name="shim_guide_start">Start setup</string>
    <string name="shim_guide_retroarch">In RetroArch:\n\n1. Main Menu → Load Core → Install or Restore a Core, and pick\n%1$s\n\n2. Main Menu → Load Core, and select “Nintendo - Game Boy Advance (VBA-M) (RetroAI)”.\nMake sure it says RetroAI — the wrong core will not set anything up.</string>
    <string name="shim_guide_launcher">In your launcher:\n\nCome back to this app and press “2 · Update the launcher”.</string>
    <string name="reload_notice_title">Reload your library</string>
    <string name="reload_notice_body">Go back to Pegasus: Settings → Reload.\n\nIf you are running the original Pegasus rather than a modified build, ignore this.</string>
    <string name="capture_needed_title">This console needs screen recording</string>
    <string name="capture_needed_body">It is drawn on the GPU, so the picture cannot be taken from inside the emulator. Screen recording works for it — Android will ask for permission next.</string>
    <string name="capture_ready_title">One more step</string>
    <string name="capture_ready_body">Make sure RetroArch is closed. Launch the game again from the frontend.</string>
    <string name="shim_guide_ok">Got it</string>
    <string name="shim_guide_body_restore">Every launch entry goes back to its real core, and any RetroArch config this app wrote is taken back off.</string>
