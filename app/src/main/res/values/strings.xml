<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        ENGLISH IS THE DEFAULT, Chinese lives in values-zh/.

        That direction is deliberate: values/ is what every locale that is not
        Chinese falls back to, so a device set to Japanese, German or anything
        else gets English rather than a language it almost certainly cannot
        read. Following the system language needs no code for this - Android
        picks the folder. The in-app switcher exists only to OVERRIDE that.

        Anything with a format argument keeps the positional form (%1$s) so a
        translation is free to reorder it.
    -->
    <string name="app_name" translatable="false">RetroAI Scaler</string>
    <string name="app_subtitle">Real-time AI upscaling layer for RetroArch</string>

