    <string name="permission_usage_title">Usage access</string>
    <string name="permission_usage_desc">Tells whether RetroArch is in the foreground. Without it the enhancement layer stays over every app and you cannot see your home screen.</string>
    <string name="permission_storage_title">All files access</string>
    <string name="permission_storage_desc">Writes the capture window into the core override configs under RetroArch/config. RetroArch\'s main config lives in Android/data, which no app can reach since Android 11, so overrides are the only route.</string>
    <string name="permission_capture_title">Screen capture (MediaProjection)</string>
    <string name="permission_capture_desc">Grabs the game\'s native frames for GPU/AI enhancement in the native layer.</string>

